# ==============================================================================
# Django Core Settings
# ==============================================================================
DEBUG=False
SECRET_KEY=django-insecure-replace-with-a-random-50-character-secret-key
ALLOWED_HOSTS=vootely.com,www.vootely.com,localhost,127.0.0.1
PUBLIC_APP_URL=https://vootely.com
CSRF_TRUSTED_ORIGINS=https://vootely.com,https://www.vootely.com
USE_X_FORWARDED_PROTO=True
SECURE_SSL_REDIRECT=True
ASGI_WORKERS=3
# 1 = Dokploy/Traefik only, 2 = Cloudflare in front of Traefik, 0 = no proxy.
TRUSTED_PROXY_COUNT=1
# Single-server launch: serve uploaded media from the media volume.
# Set this to False and configure S3/MinIO only if you move media off the server.
SERVE_LOCAL_MEDIA=True

# ==============================================================================
# PostgreSQL Database Settings
# ==============================================================================
# Self-hosted Postgres (Dokploy service or local docker-compose).
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# In local docker-compose, the host matches the service name.
# In production, set this to the Dokploy-managed Postgres connection string.
# Generate the password with: openssl rand -hex 24
# Keep the password in this URL in sync with POSTGRES_PASSWORD below.
DATABASE_URL=postgresql://votecentral:replace-with-48-char-hex@votecentral_postgres_service:5432/votecentral

# Password for the local docker-compose Postgres service
POSTGRES_PASSWORD=replace-with-48-char-hex

# ==============================================================================
# Redis / Celery Settings
# ==============================================================================
# For Docker deployment, redis host matches the service name in docker-compose.yml
REDIS_URL=redis://votecentral_redis_service:6379/0
CELERY_TASK_ALWAYS_EAGER=False
CELERY_CONCURRENCY=2

# ==============================================================================
# Paystack Payment Gateway Settings
# ==============================================================================
PAYSTACK_SECRET_KEY=your-paystack-secret-key
PAYSTACK_PUBLIC_KEY=your-paystack-public-key
PAYSTACK_WEBHOOK_SECRET=your-paystack-webhook-secret

# ==============================================================================
# SMS Provider Settings (arkesel or hubtel)
# ==============================================================================
SMS_PROVIDER=arkesel
ARKESEL_API_KEY=your-arkesel-api-key
ARKESEL_SMS_FROM=Vootely
ARKESEL_SMS_BASE_URL=https://sms.arkesel.com/api/v2
USSD_SHORT_CODE=*920*24#

# Hubtel (Alternative SMS provider)
HUBTEL_CLIENT_ID=your-hubtel-client-id
HUBTEL_CLIENT_SECRET=your-hubtel-client-secret
HUBTEL_SMS_FROM=Vootely

# ==============================================================================
# Support & Security Contacts
# ==============================================================================
SUPPORT_EMAIL=support@vootely.com
SUPPORT_PHONE=+233 54 898 8503
SUPPORT_NAME=Vootely
SECURITY_EMAIL=security@vootely.com

# ==============================================================================
# Email & SMTP Settings (e.g., Brevo)
# ==============================================================================
EMAIL_PROVIDER=brevo
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=your-sender-email@brevo.com
USSD_VOTER_EMAIL=ussd-voter@vootely.com
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-smtp-username
EMAIL_HOST_PASSWORD=your-smtp-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Vootely <noreply@vootely.com>
SERVER_EMAIL=Vootely <noreply@vootely.com>
NOTIFICATION_ADMIN_EMAILS=admin@vootely.com
